@model List<Veiculo>

<h2>Veículos Estacionados</h2>

<a asp-action="Entrada" class="btn btn-success">Registrar Entrada</a>
<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Placa</th>
            <th>Horário de Chegada</th>
            <th>Horário de Saída</th>
            <th>Duração</th>
            <th>Tempo Cobrado(hora)</th>
            <th>Preço</th>
            <th>Valor a pagar</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var veiculo in Model)
        {
            <tr>
                <td>@veiculo.Placa</td>
                <td>@veiculo.DataEntrada.ToString("g")</td>
                <td>@(veiculo.DataSaida == null ? "Ainda estacionado" : veiculo.DataSaida.Value.ToString("g"))</td>
                <td>@(veiculo.DataSaida == null ? "N/A" : (veiculo.DataSaida.Value - veiculo.DataEntrada).TotalHours.ToString("F2"))</td>
                <td>@(veiculo.DataSaida == null ? "N/A" : Math.Ceiling((veiculo.DataSaida.Value - veiculo.DataEntrada).TotalHours).ToString())</td>
                <td>@(veiculo.ValorPago > 0 ? veiculo.ValorPago.ToString("C") : "N/A")</td>
                <td>
                    @if (veiculo.DataSaida == null)
                    {
                        <a asp-action="Saida" asp-route-placa="@veiculo.Placa" class="btn btn-danger">Registrar Saída</a>
                    }
                    else
                    {
                        @veiculo.ValorPago.ToString("C")
                    }
                </td>
            </tr>
        }
    </tbody>
</table>" 