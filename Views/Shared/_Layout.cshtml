<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Estacionamento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-action="Index" asp-controller="Estacionamento">Estacionamento</a>

            <div class="navbar-nav">
                <a class="nav-link" asp-action="Index" asp-controller="Estacionamento">Veículos</a>

                <a class="nav-link" asp-action="Entrada" asp-controller="TabelaPreco">Nova Entrada</a>

                <a class="nav-link" asp-action="Index" asp-controller="TabelaPreco">Tabelas de Preço</a>

            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p>&copy; @DateTime.Now.Year - Estacionamento</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>